<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#000000"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MIDAS"
        android:textColor="#ff9f0a"
        android:textStyle="bold"
        android:textSize="36sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select mode"
        android:textColor="#8e8e93"
        android:textSize="14sp"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/btnRoleEngineer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:text="ENGINEER"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:backgroundTint="#ff9f0a"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Full console control: all channels, master, aux, VCA"
        android:textColor="#8e8e93"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnRoleMonitor"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:text="MUSICIAN (MONITOR)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:backgroundTint="#3a3a3c" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your monitor bus: channel sends and bus volume"
        android:textColor="#8e8e93"
        android:textSize="12sp"
        android:gravity="center" />

</LinearLayout>
