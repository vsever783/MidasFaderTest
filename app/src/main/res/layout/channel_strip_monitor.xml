<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="82dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="#111113"
    android:paddingBottom="@dimen/monitor_channel_strip_bottom_padding">

    <LinearLayout
        android:id="@+id/monitorChannelHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#2c2c2e"
        android:paddingTop="@dimen/monitor_channel_header_padding"
        android:paddingBottom="@dimen/monitor_channel_header_padding">

        <TextView
            android:id="@+id/textMonitorChannelLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CH 1"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="13sp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/textMonitorSendValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0,00"
        android:textColor="#ff9f0a"
        android:textStyle="bold"
        android:textSize="12sp"
        android:layout_marginTop="@dimen/monitor_channel_value_margin" />

    <!--
        Посыл канала в шину занимает ВСЮ оставшуюся высоту (запрошено) -
        ширина повёрнутого SeekBar подгоняется под реальную высоту
        программно, той же логикой, что и у обычного фейдера в инженерском
        режиме - работает и в портретной, и в альбомной ориентации одинаково.
        Рядом - узкая полоска-метр входного сигнала канала (та же логика
        подсветки зелёный/жёлтый/красный, что и в инженерском режиме).
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/monitor_channel_fader_top_margin"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp">
            <View
                android:id="@+id/monitorMeterBar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="bottom"
                android:background="#34c759" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/monitorSendContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <SeekBar
                android:id="@+id/seekMonitorSend"
                android:layout_width="220dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:max="1000"
                android:progress="0"
                android:progressTint="#ff9f0a"
                android:thumbTint="#ffffff"
                android:rotation="270" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
