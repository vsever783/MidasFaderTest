<?xml version="1.0" encoding="utf-8"?>
<!--
    НОВЫЙ отдельный экран подключения (IP/Port/Connect) - раньше это поле
    было встроено прямо в MainActivity и пересоздавалось (вместе с сокетом
    и полной подпиской) при КАЖДОМ переключении между инженерным и
    мониторным режимом. Теперь подключение происходит ОДИН раз здесь,
    дальше пользователь просто выбирает режим (RoleSelectActivity), а само
    соединение (сокет/сессия) остаётся живым при переключении между
    режимами - переключение теперь означает только смену подписок, а не
    полное пересоздание сокета.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#000000"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MIDAS"
        android:textColor="#ff9f0a"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textSize="36sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connect to console"
        android:textColor="#8e8e93"
        android:letterSpacing="0.06"
        android:textSize="14sp"
        android:layout_marginBottom="40dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Console IP"
        android:textColor="#8e8e93"
        android:textSize="11sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/editHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/console_input_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:inputType="textNoSuggestions"
        android:text="192.168.1.91"
        android:textColor="#ffffff"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Port"
        android:textColor="#8e8e93"
        android:textSize="11sp"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/editPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/console_input_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:inputType="number"
        android:text="10000"
        android:textColor="#ffffff"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/big_action_button_background"
        android:text="CONNECT"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:backgroundTint="#ff9f0a"
        android:textColor="#000000" />

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#8e8e93"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="16dp" />

</LinearLayout>
