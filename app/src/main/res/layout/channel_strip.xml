<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/channel_strip_width"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/channel_strip_card_background"
    android:paddingTop="0dp"
    android:paddingBottom="@dimen/channel_strip_padding_bottom"
    android:layout_margin="3dp">

    <!-- Цветной "бейдж" с именем канала, как на макете Midas -->
    <LinearLayout
        android:id="@+id/channelHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/channel_header_badge_background"
        android:paddingTop="@dimen/channel_header_padding"
        android:paddingBottom="@dimen/channel_header_padding">

        <TextView
            android:id="@+id/textChannelLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CH 1"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="@dimen/channel_number_text_size"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/channel_button_margin_top"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp">

        <ToggleButton
            android:id="@+id/btnSolo"
            android:layout_width="0dp"
            android:layout_height="@dimen/channel_solo_height"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="@dimen/channel_button_v_padding"
            android:paddingBottom="@dimen/channel_button_v_padding"
            android:textOn="SOLO"
            android:textOff="SOLO"
            android:textSize="10sp"
            android:textColor="#ffffff" />

        <!-- Вторая шина solo - ПОДТВЕРЖДЕНО реальным захватом. По умолчанию
             скрыта (GONE) - показывается только для мастера/aux returns/
             aux-шин через buildSimpleStrip(), не захламляет обычные 56
             каналов, у которых Solo B живёт в детальном экране. -->
        <ToggleButton
            android:id="@+id/btnSoloB"
            android:layout_width="0dp"
            android:layout_height="@dimen/channel_solo_height"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="@dimen/channel_button_v_padding"
            android:paddingBottom="@dimen/channel_button_v_padding"
            android:textOn="B"
            android:textOff="B"
            android:textSize="10sp"
            android:textColor="#ffffff"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/textLevelValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.00"
        android:textColor="#ff9f0a"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/channel_level_margin_top" />

    <!--
        Вертикальный фейдер через поворот SeekBar на 270 градусов.
        FrameLayout задаёт итоговое (уже послевращательное) пятно,
        а сам SeekBar внутри имеет размеры ДО поворота со swapped
        шириной/высотой — после поворота он занимает ровно то же
        пятно, без съехавших границ касания.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_horizontal">

        <!--
            Метр уровня сигнала - узкая полоска слева от фейдера, растёт снизу
            вверх. Высота выставляется из кода (доля от доступной высоты),
            цвет меняется зелёный -> жёлтый -> красный по порогам, как на
            типичном VU-метре.
        -->
        <FrameLayout
            android:layout_width="8dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp">
            <View
                android:id="@+id/meterBar"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="bottom"
                android:background="#34c759" />
        </FrameLayout>

        <com.example.midasfadercontrol.FaderView
            android:id="@+id/seekFader"
            android:layout_width="@dimen/channel_fader_thickness"
            android:layout_height="match_parent" />
    </LinearLayout>

    <Button
        android:id="@+id/btnMute"
        android:layout_width="match_parent"
        android:layout_height="@dimen/channel_mute_height"
        android:layout_marginTop="@dimen/channel_button_margin_top"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingTop="@dimen/channel_button_v_padding"
        android:paddingBottom="@dimen/channel_button_v_padding"
        android:text="MUTE"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#ffffff" />

</LinearLayout>
