<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Верхняя панель в стиле макета: заголовок, модель, IP, статус -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1c1c1e"
        android:padding="@dimen/top_bar_padding"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MIDAS"
            android:textColor="#ff9f0a"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" PRO REMOTE"
            android:textColor="#8e8e93"
            android:textSize="10sp"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/textConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Не подключено"
            android:textColor="#8e8e93"
            android:textSize="12sp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP"
            android:textColor="#8e8e93"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />

        <EditText
            android:id="@+id/editHost"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:text="192.168.1.91"
            android:textColor="#ffffff"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Порт"
            android:textColor="#8e8e93"
            android:textSize="12sp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp" />

        <EditText
            android:id="@+id/editPort"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="10000"
            android:textColor="#ffffff"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Подключить"
            android:backgroundTint="#ff9f0a"
            android:textColor="#000000" />
    </LinearLayout>

    </HorizontalScrollView>

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="@dimen/status_text_v_padding"
        android:paddingBottom="@dimen/status_text_v_padding"
        android:text="Не подключено"
        android:textColor="#8e8e93"
        android:textSize="11sp" />

    <!-- Переключатель режима: КАНАЛЫ / MASTER / AUX (VCA - позже) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#1c1c1e">

        <LinearLayout
            android:id="@+id/modeButtonsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/bank_row_padding" />
    </HorizontalScrollView>

    <!-- Кнопки переключения банков каналов (по 8 за раз, как в Mixing Station) -
         актуальны только в режиме КАНАЛЫ, скрываются в MASTER/AUX. -->
    <HorizontalScrollView
        android:id="@+id/bankButtonsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#151517">

        <LinearLayout
            android:id="@+id/bankButtonsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/bank_row_padding" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/containerChannels"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

            <!-- НЕ подтверждено реальным захватом трафика - см. заметку в
                 Pro2Commands.kt. -->
            <LinearLayout
                android:id="@+id/containerMaster"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />

            <!-- НЕ подтверждено реальным захватом трафика - см. заметку в
                 Pro2Commands.kt (другие имена параметров, чем у каналов). -->
            <LinearLayout
                android:id="@+id/containerAux"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />

            <!-- 16 aux-шин (СОБСТВЕННЫЙ уровень шины) - НЕ подтверждено
                 реальным захватом. -->
            <LinearLayout
                android:id="@+id/containerAuxBus"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />
        </FrameLayout>
    </HorizontalScrollView>

</LinearLayout>

    <!-- Контейнер детального экрана канала - изначально скрыт, показывается
         поверх всего остального при открытии (см. openChannelDetail в коде). -->
    <FrameLayout
        android:id="@+id/channelDetailContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
