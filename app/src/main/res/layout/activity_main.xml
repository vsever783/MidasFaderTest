<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Верхняя панель в стиле макета: заголовок, модель, IP, статус -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1c1c1e"
        android:padding="@dimen/top_bar_padding"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MIDAS"
            android:textColor="#ff9f0a"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" PRO REMOTE"
            android:textColor="#8e8e93"
            android:textSize="10sp"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/textConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Not connected"
            android:textColor="#8e8e93"
            android:textSize="12sp"
            android:layout_weight="1" />

        <!-- Компактная кнопка "изменить" - видна только ПОСЛЕ подключения,
             открывает поля IP/Port обратно (см. containerConnectForm ниже).
             Форма подключения нужна один раз, а не постоянно на экране -
             после успешного коннекта прячем её, освобождая место под
             реальные органы управления. -->
        <Button
            android:id="@+id/btnChangeConnection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/console_button_background"
            android:text="Change"
            android:textSize="11sp"
            android:backgroundTint="#3a3a3c"
            android:textColor="#ffffff"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/containerConnectForm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP"
            android:textColor="#8e8e93"
            android:textSize="12sp"
            android:layout_marginEnd="4dp" />

        <EditText
            android:id="@+id/editHost"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:background="@drawable/console_input_background"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:inputType="text"
            android:text="192.168.1.91"
            android:textColor="#ffffff"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Port"
            android:textColor="#8e8e93"
            android:textSize="12sp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp" />

        <EditText
            android:id="@+id/editPort"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:background="@drawable/console_input_background"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:inputType="number"
            android:text="10000"
            android:textColor="#ffffff"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/console_button_background"
            android:text="Connect"
            android:backgroundTint="#ff9f0a"
            android:textColor="#000000" />
        </LinearLayout>
    </LinearLayout>

    </HorizontalScrollView>

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="@dimen/status_text_v_padding"
        android:paddingBottom="@dimen/status_text_v_padding"
        android:text="Not connected"
        android:textColor="#8e8e93"
        android:textSize="11sp" />

    <!-- Переключатель режима + банки каналов - раньше были ДВЕ отдельные
         полосы друг под другом (вкладки режима сверху, банки снизу),
         теперь одна строка: экономит целую полосу по высоте, особенно
         заметно в альбомной ориентации на телефоне, где высота и так в
         дефиците. Банки скрываются целиком (вместе с разделителем) вне
         режима КАНАЛЫ - см. bankButtonsScroll в коде. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1c1c1e">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:id="@+id/modeButtonsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/bank_row_padding" />

                <LinearLayout
                    android:id="@+id/bankButtonsScroll"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="#3a3a3c" />

                    <LinearLayout
                        android:id="@+id/bankButtonsRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/bank_row_padding" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <Button
            android:id="@+id/btnGlobalTap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/console_button_background"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="TAP"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:backgroundTint="#3a3a3c" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/containerChannels"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

            <!-- НЕ подтверждено реальным захватом трафика - см. заметку в
                 Pro2Commands.kt. -->
            <LinearLayout
                android:id="@+id/containerMaster"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />

            <!-- НЕ подтверждено реальным захватом трафика - см. заметку в
                 Pro2Commands.kt (другие имена параметров, чем у каналов). -->
            <LinearLayout
                android:id="@+id/containerAux"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />

            <!-- 16 aux-шин (СОБСТВЕННЫЙ уровень шины) - НЕ подтверждено
                 реальным захватом. -->
            <LinearLayout
                android:id="@+id/containerAuxBus"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />

            <!-- VCA-группы (8 шт.) - ПОЛНОСТЬЮ ПОДТВЕРЖДЕНО реальным
                 захватом трафика iPad (Mixtender). -->
            <LinearLayout
                android:id="@+id/containerVca"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />

            <!-- Main Outs (8 шт., "matrix out" на самом пульте) - фейдер/
                 mute/solo/имя/цвет ПОДТВЕРЖДЕНЫ ЧАСТИЧНО (fader - сторонним
                 датасетом; mute/solo/цвет - по аналогии с другими группами,
                 не найдены явно в том же датасете). EQ/компрессор Main Outs
                 пока не реализованы - отдельная большая задача. -->
            <LinearLayout
                android:id="@+id/containerMainOuts"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />
        </FrameLayout>
    </HorizontalScrollView>

</LinearLayout>

    <!-- Контейнер детального экрана канала - изначально скрыт, показывается
         поверх всего остального при открытии (см. openChannelDetail в коде). -->
    <FrameLayout
        android:id="@+id/channelDetailContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
