<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Верхняя панель: заголовок + статус подключения. Сама форма
         подключения (IP/Port/Connect) переехала на отдельный экран
         ConnectActivity - к этому моменту соединение уже всегда
         установлено, здесь остаётся только показывать статус. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1c1c1e"
        android:padding="@dimen/top_bar_padding"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MIDAS"
            android:textColor="#ff9f0a"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/textConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Not connected"
            android:textColor="#8e8e93"
            android:textSize="11sp"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/textStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#000000"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="@dimen/status_text_v_padding"
        android:paddingBottom="@dimen/status_text_v_padding"
        android:text="Not connected"
        android:textColor="#8e8e93"
        android:textSize="11sp" />

    <!-- Переключатель режима: КАНАЛЫ / MASTER / AUX и т.д. + глобальная
         кнопка TAP (задаёт темп делею/эффектам с этой функцией). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1c1c1e">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/modeButtonsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/bank_row_padding" />
        </HorizontalScrollView>

        <Button
            style="@style/Widget.Midas.Button"
            android:id="@+id/btnGlobalTap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/console_button_background"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="TAP"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:backgroundTint="#3a3a3c" />
    </LinearLayout>

    <!-- Кнопки переключения банков каналов - актуальны только в режиме
         КАНАЛЫ, скрываются целиком в MASTER/AUX и т.д. -->
    <HorizontalScrollView
        android:id="@+id/bankButtonsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#151517">

        <LinearLayout
            android:id="@+id/bankButtonsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/bank_row_padding" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/containerChannels"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

            <!-- НЕ подтверждено реальным захватом трафика - см. заметку в
                 Pro2Commands.kt. -->
            <LinearLayout
                android:id="@+id/containerMaster"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />

            <!-- НЕ подтверждено реальным захватом трафика - см. заметку в
                 Pro2Commands.kt (другие имена параметров, чем у каналов). -->
            <LinearLayout
                android:id="@+id/containerAux"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />

            <!-- 16 aux-шин (СОБСТВЕННЫЙ уровень шины) - НЕ подтверждено
                 реальным захватом. -->
            <LinearLayout
                android:id="@+id/containerAuxBus"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />

            <!-- VCA-группы (8 шт.) - ПОЛНОСТЬЮ ПОДТВЕРЖДЕНО реальным
                 захватом трафика iPad (Mixtender). -->
            <LinearLayout
                android:id="@+id/containerVca"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />

            <!-- Мьют-группы - структура из стороннего датасета (симметрична
                 VCA), НЕ подтверждено собственным захватом трафика. -->
            <LinearLayout
                android:id="@+id/containerMuteGroups"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />

            <!-- Main Outs (8 шт., "matrix out" на самом пульте) - фейдер/
                 mute/solo/имя/цвет ПОДТВЕРЖДЕНЫ ЧАСТИЧНО (fader - сторонним
                 датасетом; mute/solo/цвет - по аналогии с другими группами,
                 не найдены явно в том же датасете). EQ/компрессор Main Outs
                 пока не реализованы - отдельная большая задача. -->
            <LinearLayout
                android:id="@+id/containerMainOuts"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:visibility="gone" />
        </FrameLayout>
    </HorizontalScrollView>

</LinearLayout>

    <!-- Контейнер детального экрана канала - изначально скрыт, показывается
         поверх всего остального при открытии (см. openChannelDetail в коде). -->
    <FrameLayout
        android:id="@+id/channelDetailContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
