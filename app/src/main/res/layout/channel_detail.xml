<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Верхняя панель: назад + имя канала -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#1c1c1e"
        android:padding="12dp">

        <Button
            android:id="@+id/btnDetailBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#ffffff"
            android:backgroundTint="#3a3a3c" />

        <TextView
            android:id="@+id/textDetailChannelName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="CH 1"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:textSize="20sp" />
    </LinearLayout>

    <!--
        Ряд "блоков обработки" - COMP и SENDS, задел под EQ и т.д. в будущем:
        просто добавляем сюда ещё такие же кнопки-вкладки, когда появится,
        что в них показывать.
    -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#1c1c1e">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTabInput"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="INPUT"
            android:textColor="#000000"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:backgroundTint="#ff9f0a" />

        <!-- Тонкий разделитель вместо промежутка между кнопками - единая
             полоса вкладок, а не отдельные кнопки с зазорами. -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3a3a3c" />

        <Button
            android:id="@+id/btnTabComp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="COMP"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:backgroundTint="#1c1c1e" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3a3a3c" />

        <Button
            android:id="@+id/btnTabSends"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="SENDS"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:backgroundTint="#1c1c1e" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3a3a3c" />

        <Button
            android:id="@+id/btnTabEq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="EQ"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:backgroundTint="#1c1c1e" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#3a3a3c" />

        <Button
            android:id="@+id/btnTabGate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="GATE"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:background="@android:color/transparent"
            android:backgroundTint="#1c1c1e" />
    </LinearLayout>
    </HorizontalScrollView>

    <!-- Основная область: контент слева, mute/solo/фейдер/метр справа -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Содержимое текущего блока (INPUT/COMP/EQ/GATE) - SENDS вынесен
             отдельно (см. ниже), у него своя горизонтальная прокрутка. -->
        <ScrollView
            android:id="@+id/tabContentScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!--
                Вход канала - гейн (уже подключено), позже сюда же добавятся
                48V, переворот фазы и отдельная ручка gain trim.
            -->
            <LinearLayout
                android:id="@+id/inputBlockContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/card_panel_background"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="12dp">

                <!-- ВАЖНО: на пульте два разных гейна (оба подтверждены
                     реальным захватом) - основной GAIN (enInputGain) и
                     отдельный GAIN TRIM (enMicSplitStepGain). Раньше мы по
                     ошибке называли TRIM просто "GAIN" - теперь разделены. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GAIN"
                            android:textColor="#ff9f0a"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:letterSpacing="0.12"
                            android:layout_marginBottom="12dp" />

                        <com.example.midasfadercontrol.RotaryKnobView
                            android:id="@+id/knobDetailGain"
                            android:layout_width="100dp"
                            android:layout_height="100dp" />

                        <TextView
                            android:id="@+id/textDetailGainValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0,00"
                            android:textColor="#8e8e93"
                            android:textSize="14sp"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GAIN TRIM"
                            android:textColor="#ff9f0a"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:letterSpacing="0.12"
                            android:layout_marginBottom="12dp" />

                        <com.example.midasfadercontrol.RotaryKnobView
                            android:id="@+id/knobDetailGainTrim"
                            android:layout_width="100dp"
                            android:layout_height="100dp" />

                        <TextView
                            android:id="@+id/textDetailGainTrimValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0,00"
                            android:textColor="#8e8e93"
                            android:textSize="14sp"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 48V и переворот фазы - ПОДТВЕРЖДЕНО реальным захватом
                     (48V) / списком команд (фаза). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnDetailPhantom"
                        android:background="@drawable/console_button_background"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="48V OFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:backgroundTint="#3a3a3c" />

                    <Button
                        android:id="@+id/btnDetailPhase"
                        android:background="@drawable/console_button_background"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="PHASE NORM"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:backgroundTint="#3a3a3c" />
                </LinearLayout>

                <!-- Стерео-пара (link) - НЕ подтверждено реальным захватом. -->
                <Button
                    android:id="@+id/btnDetailLink"
                    android:background="@drawable/console_button_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="LINK OFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:backgroundTint="#3a3a3c" />

                <!-- Панорама - ПОДТВЕРЖДЕНО реальным захватом. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PAN"
                    android:textColor="#ff9f0a"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp" />
                <SeekBar
                    android:id="@+id/seekDetailPan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="1000"
                    android:progress="500" />
                <TextView
                    android:id="@+id/textDetailPanValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CENTER"
                    android:textColor="#8e8e93"
                    android:textSize="12sp" />

                <!-- Переименование/перекраска канала прямо из приложения. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <EditText
                        android:id="@+id/editDetailChannelName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Channel name"
                        android:textColor="#ffffff"
                        android:textColorHint="#888888"
                        android:maxLines="1" />

                    <Button
                        android:id="@+id/btnDetailApplyName"
                        android:background="@drawable/console_button_background"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="OK"
                        android:backgroundTint="#ff9f0a"
                        android:textColor="#000000" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHANNEL COLOUR"
                    android:textColor="#8e8e93"
                    android:textSize="11sp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/rowColourSwatches"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:orientation="horizontal" />

                <!-- HP/LP фильтры и задержка входа - ПОДТВЕРЖДЕНО реальным
                     захватом. Крутизна (slope) не реализована - отдельный
                     циклический параметр, не непрерывное значение. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnDetailHpFilterIn"
                        android:background="@drawable/console_button_background"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="HP FILTER OFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:backgroundTint="#3a3a3c" />

                    <Button
                        android:id="@+id/btnDetailLpFilterIn"
                        android:background="@drawable/console_button_background"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="LP FILTER OFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:backgroundTint="#3a3a3c" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HP FREQ"
                    android:textColor="#ff9f0a"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:layout_marginTop="12dp" />
                <SeekBar
                    android:id="@+id/seekDetailHpFreq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="1000"
                    android:progress="0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LP FREQ"
                    android:textColor="#ff9f0a"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:layout_marginTop="12dp" />
                <SeekBar
                    android:id="@+id/seekDetailLpFreq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="1000"
                    android:progress="1000" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INPUT DELAY"
                    android:textColor="#ff9f0a"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:layout_marginTop="12dp" />
                <SeekBar
                    android:id="@+id/seekDetailDelay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="1000"
                    android:progress="0" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/compBlockContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/card_panel_background"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone" />
            <!-- Заполняется программно (сетка ручек + график) в openChannelDetail() -->

            <LinearLayout
                android:id="@+id/eqBlockContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/card_panel_background"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone" />
            <!-- Заполняется программно (4 полосы EQ) в openChannelDetail() -->

            <LinearLayout
                android:id="@+id/gateBlockContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/card_panel_background"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone" />
            <!-- Заполняется программно (Gate) в openChannelDetail() -->

          </LinearLayout>
        </ScrollView>

        <!--
            SENDS - НЕ внутри общей вертикальной прокрутки (в отличие от
            остальных вкладок): у него уже есть своя ГОРИЗОНТАЛЬНАЯ прокрутка
            для 16 колонок, а высота нужна ВСЯ доступная (для вертикальных
            фейдеров), а не гадание с фиксированным dp. Поэтому - отдельный
            равноправный элемент рядом со ScrollView, а не внутри него.
        -->
        <HorizontalScrollView
            android:id="@+id/sendsBlockContent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/sendsBlockRow"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </HorizontalScrollView>
        <!-- Заполняется программно (16 aux-посылов, таблица-полосы) в openChannelDetail() -->

        <!--
            Постоянная боковая панель - видна независимо от того, какой блок
            открыт (COMP/EQ/Sends в будущем). Как в Mixing Station: уровень
            всегда под контролем, даже когда крутишь эффекты.
        -->
        <LinearLayout
            android:layout_width="80dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="#151517"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ToggleButton
                android:id="@+id/detailSolo"
                android:background="@drawable/console_button_background"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:textOn="SOLO"
                android:textOff="SOLO"
                android:textSize="10sp"
                android:textColor="#ffffff" />

            <!-- Вторая шина solo - ПОДТВЕРЖДЕНО реальным захватом (есть
                 даже у обычных каналов). -->
            <ToggleButton
                android:id="@+id/detailSoloB"
                android:background="@drawable/console_button_background"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="4dp"
                android:textOn="SOLO B"
                android:textOff="SOLO B"
                android:textSize="9sp"
                android:textColor="#ffffff" />

            <Button
                android:id="@+id/detailMute"
                android:background="@drawable/console_button_background"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginTop="6dp"
                android:text="MUTE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#ffffff" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_horizontal">

                <FrameLayout
                    android:layout_width="6dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp">
                    <View
                        android:id="@+id/detailMeterBar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="bottom"
                        android:background="#34c759"
                        android:scaleY="0" />
                </FrameLayout>

                <com.example.midasfadercontrol.FaderView
                    android:id="@+id/detailFader"
                    android:layout_width="34dp"
                    android:layout_height="match_parent" />
            </LinearLayout>

            <TextView
                android:id="@+id/textDetailLevelValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0,00"
                android:textColor="#ff9f0a"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
