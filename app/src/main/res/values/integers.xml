<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Ориентация раскладки внутри вкладок детального экрана.
        LinearLayout принимает orientation как integer: 0 = horizontal,
        1 = vertical. Благодаря этому одна и та же разметка работает и в
        портретной, и в альбомной ориентации - без дубликата файла в
        layout-land/, который пришлось бы вручную держать в синхронизации.

        Портретная: 1 (вертикально) - колонки идут одна под другой.
    -->
    <integer name="detail_columns_orientation">1</integer>
</resources>
