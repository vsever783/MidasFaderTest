+    const val SOURCE_SILENCE: Int = -2147483648 // 0x80000000
+
+    /** DL251 (Type 42), сквозной физический канал 1..48, path всегда 0. */
+    fun dl251Source(physicalChannel: Int): Int =
+        42 or ((physicalChannel - 1) shl 20)
+
